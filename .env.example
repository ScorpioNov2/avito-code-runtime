# Signaling server cho y-webrtc (xem README, mục "Signaling server"). Nhiều server ngăn cách bằng dấu phẩy.
# Trang chạy trên HTTPS (GitHub Pages) thì BẮT BUỘC dùng wss://, không dùng ws://.
# Để trống = dùng server mặc định của y-webrtc (hay không ổn định).
VITE_SIGNALING_URLS=wss://avito-code-signaling.<your-subdomain>.workers.dev

# Danh sách signaling server cho y-webrtc, ngăn cách bằng dấu phẩy.
# Để trống = dùng server công cộng mặc định của y-webrtc (hay không ổn định).
VITE_SIGNALING_URLS=wss://your-signaling-server.example.com

# Java chạy bằng CheerpJ. Mặc định tải runtime do Leaning Technologies host (miễn phí cho dự án cá nhân/phi thương mại).
# Tự host runtime cần giấy phép thương mại CheerpJ; khi đó trỏ tới file loader bạn đã host:
# VITE_CHEERPJ_LOADER_URL=/wasm/cheerpj/loader.js
# VITE_CHEERPJ_JAVA_VERSION=21
